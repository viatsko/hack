{
  "name": "with-typescript",
  "version": "1.0.0",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc",
    "ts-node": "ts-node --project ./tsconfig.ts-node.json",
    "genworld": "yarn run ts-node ./scripts/generateProfilesIndex.ts && yarn run ts-node ./scripts/generateMainFeed.ts",
    "updateall": "yarn run ts-node ./scripts/updateYouTubeVideos.ts && yarn run genworld"
  },
  "dependencies": {
    "@material-ui/core": "^4.9.11",
    "@material-ui/icons": "^4.9.1",
