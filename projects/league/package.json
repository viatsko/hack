{
  "name": "with-typescript",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=4096 next",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc",
    "ts-node": "ts-node --project ./tsconfig.ts-node.json",
    "genworld": "yarn run ts-node ./scripts/generateProfilesIndex.ts && yarn run ts-node ./scripts/generateMainFeed.ts && yarn run ts-node ./scripts/generateChampionPages.ts",
    "updateall": "yarn run ts-node ./scripts/updateYouTubeVideos.ts && yarn run ts-node ./scripts/updateReddit.ts && yarn run genworld",
    "profile": "yarn run ts-node ./scripts/buildProfileFromYouTube.ts && yarn run genworld"
  },
  "dependencies": {
    "@material-ui/core": "^4.9.11",
    "@material-ui/icons": "^4.9.1",
    "@zeit/next-css": "^1.0.1",
    "@zeit/next-sass": "^1.0.1",
    "axios": "^0.19.2",
    "classnames": "^2.2.6",
    "cross-env": "^7.0.2",
    "googleapis": "^49.0.0",
    "image-trace-loader": "^1.0.2",
    "imagemin-mozjpeg": "^9.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-pngquant": "^9.0.0",
    "imagemin-svgo": "^8.0.0",
    "isomorphic-unfetch": "^3.0.0",
    "lol-champions": "*",
    "next": "latest",
    "next-fonts": "^1.4.0",
    "next-images": "^1.4.0",
    "next-optimized-images": "^2.6.1",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-youtube": "^7.11.2",
    "sanitize-html": "^1.23.0",
    "ts-node": "^8.8.2"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/classnames": "^2.2.10",
    "@types/node": "^12.12.21",
    "@types/react": "^16.9.16",
    "@types/react-dom": "^16.9.4",
    "@types/react-youtube": "^7.6.2",
    "@types/sanitize-html": "^1.22.0",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.28.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-react": "^7.19.0",
    "prettier": "^2.0.4",
    "typescript": "*"
  },
  "license": "ISC",
  "browserslist": [
    "last 2 version",
    "not dead",
    "not ie <= 11"
  ]
}
